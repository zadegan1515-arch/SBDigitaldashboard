{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$CLAUDE_PROJECT_DIR/scripts/chat-log-hook.mjs\" ] && node \"$CLAUDE_PROJECT_DIR/scripts/chat-log-hook.mjs\" 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$CLAUDE_PROJECT_DIR/scripts/chat-log-hook.mjs\" ] && node \"$CLAUDE_PROJECT_DIR/scripts/chat-log-hook.mjs\" 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion|ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$CLAUDE_PROJECT_DIR/scripts/chat-log-hook.mjs\" ] && node \"$CLAUDE_PROJECT_DIR/scripts/chat-log-hook.mjs\" 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
