// SB Agency — Command Center
// Sponsor prospecting + LinkedIn outreach
//
// Standalone. Does not touch the sb-crm database.
// Designed so a link to sb-crm (shows, chapters) can be added later
// via nullable reference fields rather than a restructure.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // directUrl deliberately omitted. It requires DATABASE_URL_UNPOOLED,
  // which isn't reliably set on these Vercel projects — a missing one
  // fails the build with P1012 before anything else runs. sb-crm hit
  // this same wall and removed it for the same reason.
  // Neon's pooled endpoint handles `prisma db push` fine.
}

// ---------------------------------------------------------------
// Brands
// ---------------------------------------------------------------

model Brand {
  id        String   @id @default(cuid())
  name      String   @unique
  website   String?
  hq        String?

  // "beverage", "cpg", "apparel", "nicotine", "betting"...
  category  String?
  // "emerging" | "growth" | "established" — drives prioritisation
  tier      String?

  // Where this record came from: "sponsorunited" | "manual" | "import"
  source        String   @default("manual")
  // SponsorUnited profile ULID, so we can re-sync without duplicating
  externalId    String?  @unique
  // Their public LinkedIn company page (distinct from a person's profile)
  linkedinUrl   String?

  notes     String?

  // Discovery notes — what this brand actually wants (goals, regions,
  // timing), captured on the first call. Feeds the proposal generator so
  // pitches read tailored instead of generic.
  goals     String?

  // Which rep owns this relationship. Free text rather than an enum —
  // the team grows, and a new hire shouldn't need a schema migration.
  owner     String?

  // Hard exclusion from the email machine: no intros, no follow-ups.
  // Also honored implicitly when the notes contain the word "skip".
  doNotEmail Boolean @default(false)

  contacts  Contact[]
  targets   Target[]
  partner   Partner?
  shows     ShowSponsor[]
  deals     Deal[]
  documents Document[]
  activations Activation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([tier])
}

// ---------------------------------------------------------------
// People at brands
// ---------------------------------------------------------------

model Contact {
  id       String  @id @default(cuid())
  brandId  String
  brand    Brand   @relation(fields: [brandId], references: [id], onDelete: Cascade)

  name     String
  title    String?
  email    String?
  phone    String?
  location String?

  // The field this whole Salesforce exercise exists to carry.
  linkedinUrl String?
  twitterUrl  String?

  source     String  @default("manual")
  externalId String? @unique

  // True when the title suggests they buy sponsorships —
  // "College & Field Marketing", "Sports Marketing", "Partnerships".
  // Set by a heuristic on import, editable by hand.
  isDecisionMaker Boolean @default(false)

  targets  Target[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId])
  @@index([isDecisionMaker])
}

// ---------------------------------------------------------------
// Outreach queue — one row per person we intend to contact
// ---------------------------------------------------------------

enum TargetStatus {
  queued
  drafted
  sent
  replied
  converted
  declined
  dead
}

model Target {
  id        String @id @default(cuid())
  brandId   String
  brand     Brand   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  status    TargetStatus @default(queued)

  // Which rep sends this. Currently always Zach.
  assignedTo String?

  // 0-100. Drives the "Today" queue ordering so the best targets
  // go out first — matters because one LinkedIn account caps
  // near 100 connection requests a week.
  fitScore  Int  @default(50)

  // Parked out of the send queue by the per-brand cap (top 3 by fit).
  // The person stays fully in the system on their brand page — one click
  // promotes them back. This is how "only reach the best few per brand"
  // is enforced without ever deleting anyone. Default false, so existing
  // rows and every new target start active until a cap shelves them.
  shelved   Boolean @default(false)

  // Follow-up layer — the connective tissue that keeps a deal moving after
  // "sent". nextStep is what to do next in plain words; followUpAt is when
  // it's due. Both drive the dashboard's "Needs action" list so a reply or
  // a due follow-up never falls through the cracks.
  nextStep   String?
  followUpAt DateTime?

  // Set when it lands in a day's send list, so "Today" is stable
  // and doesn't reshuffle mid-session.
  queuedFor DateTime?
  sentAt    DateTime?
  repliedAt DateTime?

  notes     String?

  drafts    Draft[]
  events    TargetEvent[]
  emails    EmailMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contactId])
  @@index([status])
  @@index([queuedFor])
  @@index([fitScore])
  @@index([shelved])
  @@index([followUpAt])
}

// ---------------------------------------------------------------
// Generated messages
// ---------------------------------------------------------------

model Draft {
  id       String @id @default(cuid())
  targetId String
  target   Target @relation(fields: [targetId], references: [id], onDelete: Cascade)

  // "identity" (lead with who we are + proof)
  // "question" (lead with a specific ask)
  variant  String

  // LinkedIn caps the connection note at 300 chars and
  // the first message at 600. Enforced in the UI, not here,
  // so a long draft is still saved and visibly over.
  connectionNote String
  firstMessage   String

  // Which voice profile generated it
  voice     String?
  model     String?
  // Whether a human edited it before sending — the signal we need
  // to improve the prompts over time.
  editedByHuman Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([targetId])
}

// ---------------------------------------------------------------
// Audit trail — every status change, so we can measure what works
// ---------------------------------------------------------------

model TargetEvent {
  id       String @id @default(cuid())
  targetId String
  target   Target @relation(fields: [targetId], references: [id], onDelete: Cascade)

  // "queued" | "drafted" | "sent" | "replied" | "note"
  kind      String
  fromStatus String?
  toStatus   String?
  actor      String?
  detail     String?

  createdAt DateTime @default(now())

  @@index([targetId])
  @@index([createdAt])
}

// ---------------------------------------------------------------
// CRM — brands that became relationships
// ---------------------------------------------------------------

enum Lifecycle {
  prospect
  in_network
  active_partner
  past_partner
}

model Partner {
  id      String @id @default(cuid())
  brandId String @unique
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  lifecycle   Lifecycle @default(prospect)
  // "title sponsor" | "sampling" | "product seeding"...
  relationship String?
  owner        String?
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lifecycle])
}

// ---------------------------------------------------------------
// Pipeline
// ---------------------------------------------------------------

model Deal {
  id      String @id @default(cuid())
  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  name  String
  // "conversation" | "proposal" | "verbal" | "closed" | "lost"
  stage String @default("conversation")
  // Cents, not dollars — never store money as a float.
  //
  // This is SPONSORSHIP money only. Booking revenue (what a chapter pays
  // for the artist) lives in sb-crm and is never mixed in here — they are
  // two separate revenue lines and summing them would be meaningless.
  valueCents Int @default(0)

  // Free text for now. When we link to sb-crm this becomes a
  // real reference to a show or season rather than a string.
  eventRef  String?
  closeDate DateTime?
  notes     String?

  owner  String?
  // "manual" — someone typed it in
  // "sponsorship" — generated by attaching a brand to a show. These are
  // kept in sync automatically and should not be hand-edited; edit the
  // sponsorship instead.
  source String @default("manual")

  // Set for source="notion": the Notion page URL this deal mirrors, so
  // the nightly sync can find and update it without duplicating.
  // Indexed but deliberately NOT unique — a unique constraint makes
  // `prisma db push` demand --accept-data-loss on existing tables.
  externalRef String?

  // Set for source="sponsorship". Unique so one attachment can only ever
  // produce one deal, and cascading so detaching a show removes the deal
  // rather than leaving a phantom number in the pipeline total.
  showSponsorId String?      @unique
  showSponsor   ShowSponsor? @relation(fields: [showSponsorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stage])
  @@index([brandId])
  @@index([source])
  @@index([externalRef])
}

// ---------------------------------------------------------------
// Voice profiles — how drafts learn to sound like a real person
// ---------------------------------------------------------------

model Voice {
  id   String @id @default(cuid())
  name String @unique   // "Zach"
  role String?          // shown in signatures

  // Distilled instructions built from real sample messages.
  // Empty until Zach's messages arrive — drafts read generic until then.
  guidelines String?
  // Verbatim examples. The actual source of the voice.
  samples    String[]

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------
// Sponsor ↔ Show
// ---------------------------------------------------------------
//
// Shows are NOT stored here. They live in sb-crm's Lead table and are
// read live over a second, read-only connection — so a stage change
// there shows up here instantly and there's no sync job to drift.
//
// This table holds only the link. crmLeadId is sb-crm's Lead.id, kept
// as a plain string since there's no foreign key across databases.

model ShowSponsor {
  id      String @id @default(cuid())
  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  crmLeadId String

  // Copies taken at attach time. If the show is later deleted or
  // renamed in sb-crm, this still reads sensibly instead of becoming
  // an orphaned ID.
  school    String?
  chapter   String?
  artist    String?
  eventDate String?

  // proposed  — pitched, not agreed
  // confirmed — brand has agreed to sponsor this show
  // declined  — brand passed on this one
  status     String @default("proposed")
  valueCents Int    @default(0)

  // What the brand actually gets. Varies per show — sampling at one,
  // stage banner at another — so it lives on the link, not the brand.
  deliverables String?

  notes     String?

  // Which rep closed this one. Drives per-rep attribution on the ledger.
  owner     String?

  // The auto-generated pipeline deal. Created on attach, updated on every
  // edit, removed by cascade on detach.
  deal      Deal?

  // Fulfillment checklist — the individual deliverables promised for this
  // show, ticked off with proof as they happen. Drives the recap.
  deliverableItems Deliverable[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One row per brand per show. Attaching twice is always a mistake.
  @@unique([brandId, crmLeadId])
  @@index([crmLeadId])
  @@index([status])
  @@index([owner])
}

// ---------------------------------------------------------------
// Access — who may sign in, beyond the founding ALLOWED_EMAILS
// ---------------------------------------------------------------
//
// ALLOWED_EMAILS in Vercel stays the root list (Leo, Zach, Elizabeth)
// and still fails closed. This table holds everyone added from the
// Team page, so granting access no longer needs a redeploy.

model AllowedEmail {
  id      String @id @default(cuid())
  email   String @unique
  addedBy String?

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------
// Todos
// ---------------------------------------------------------------

model Todo {
  id       String  @id @default(cuid())
  text     String
  category String?
  owner    String?
  done     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([done])
}

// ---------------------------------------------------------------
// Fulfillment — one promised deliverable for a sponsored show
// ---------------------------------------------------------------

model Deliverable {
  id            String      @id @default(cuid())
  showSponsorId String
  showSponsor   ShowSponsor @relation(fields: [showSponsorId], references: [id], onDelete: Cascade)

  text     String
  done     Boolean @default(false)
  // Link to proof — a photo album, a post, a report.
  proofUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([showSponsorId])
}

// ---------------------------------------------------------------
// Generated documents — proposals and recaps
// ---------------------------------------------------------------
//
// One model for both. A proposal is written before the sale to pitch a
// brand; a recap is written after the show to prove what they got and
// earn the renewal. Content is markdown so it can be copied straight out.

model Document {
  id      String @id @default(cuid())
  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  // Optional link to the specific sponsorship a recap covers.
  showSponsorId String?

  // "proposal" | "recap"
  kind    String
  title   String
  content String

  // Which model wrote it, for the record.
  model  String?
  author String?

  createdAt DateTime @default(now())

  @@index([brandId])
  @@index([kind])
}

// ---------------------------------------------------------------
// Email outreach — every message out or in, per target
// ---------------------------------------------------------------
//
// The email channel runs beside LinkedIn, never through it: sending an
// email does not touch the target's LinkedIn status or the 10/day
// LinkedIn budget. A reply from either channel marks the target replied.
// The sending mailbox lives in env vars (EMAIL_USER/EMAIL_APP_PASSWORD),
// so swapping the personal address for marketing@ later is a settings
// change, not a code change.

model EmailMessage {
  id       String @id @default(cuid())
  targetId String
  target   Target @relation(fields: [targetId], references: [id], onDelete: Cascade)

  // "out" — we sent it; "in" — they wrote back
  direction String
  // "intro" | "followup" | "reply"
  kind      String
  // out: "draft" -> "sent" | "failed"; in: "received"
  status    String @default("draft")

  toEmail   String?
  fromEmail String?
  // Extra recipients CC'd on the send, JSON array of addresses:
  // ["a@x.com","b@y.com"]. Null/empty = no CC.
  ccEmails  String?
  subject   String?
  body      String?
  error     String?

  // Open tracking: the pixel at /api/track?e=<id> bumps these.
  opens     Int       @default(0)
  openedAt  DateTime?

  // AI angle for this specific brand, JSON: {"tip": advice for the rep,
  // "insert": a ready-made sentence they can drop into the email}.
  suggestion String?

  sentAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([targetId])
  @@index([status])
  @@index([direction])
}

// ---------------------------------------------------------------
// Settings — small key/value store (the rate card lives here)
// ---------------------------------------------------------------

// ---------------------------------------------------------------
// Discover — AI-found brand candidates, waiting for a human verdict
// ---------------------------------------------------------------
//
// Rows are written by the Discover tab's web search. Only brands with a
// verified LinkedIn company page get stored (no LinkedIn = discarded
// before it ever reaches here). "Add" promotes one into the real Brand
// table; until then it lives only on this bench.

model DiscoveredBrand {
  id    String @id @default(cuid())
  query String   // the search that surfaced it, verbatim
  name  String

  category    String?  // mapped to our category keys
  reason      String?  // one line: why it fits the query
  // The pitch: a concrete SB Agency activation this brand could buy.
  activation  String?
  website     String?
  linkedinUrl String?

  // "new" | "added" (promoted to Brand, or already existed) | "dismissed"
  status  String  @default("new")
  brandId String? // set once linked to a real Brand

  createdAt DateTime @default(now())

  @@unique([query, name])
  @@index([status])
  @@index([createdAt])
}

model Setting {
  key       String   @id
  // JSON string. The rate card is stored under key "rateCard".
  value     String
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------
// Activations — signed deals being carried out
// ---------------------------------------------------------------
//
// Pipeline ends at "closed". This is what happens next: the work of
// actually delivering what was sold. One Activation per signed deal;
// one or more Events under it (Underdog is one venue takeover, a
// multi-show deal would be several); each Event owns its own budget,
// task list and staff. Money here is COST, kept apart from both
// sponsorship revenue (Deal.valueCents) and booking revenue (sb-crm) —
// three separate lines, never summed across.

model Activation {
  id      String @id @default(cuid())
  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  // Optional link back to the Pipeline deal it fulfils.
  dealId  String?

  name   String
  // "planning" | "in_progress" | "delivered" | "recapped"
  status String @default("planning")
  owner  String?
  notes  String?

  events ActivationEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId])
  @@index([status])
}

model ActivationEvent {
  id           String     @id @default(cuid())
  activationId String
  activation   Activation @relation(fields: [activationId], references: [id], onDelete: Cascade)

  name      String
  venue     String?
  city      String?
  eventDate DateTime?
  loadIn    String?
  eventTime String?
  loadOut   String?
  notes     String?

  // Top of the production sheet. Cents. The approved budget is what the
  // brand signed off; agency fee is SB's; grand total is the invoice.
  budgetCents    Int @default(0)
  agencyFeeCents Int @default(0)

  lines BudgetLine[]
  tasks ActivationTask[]
  staff EventStaff[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([activationId])
  @@index([eventDate])
}

// One row of the production sheet.
model BudgetLine {
  id      String          @id @default(cuid())
  eventId String
  event   ActivationEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // "venue" | "production" | "print" | "staff" | "talent" — the sheet's
  // section headers, so the page can rebuild the sheet's shape.
  section     String
  item        String
  description String?
  qty         Int?
  unitCents   Int?
  // Estimate is what was budgeted; final is what it actually cost.
  // Variance is derived, never stored.
  estimateCents Int  @default(0)
  finalCents    Int?
  notes         String?
  // The sheet's "ordered" / "confirmed" checkbox.
  ordered   Boolean @default(false)
  sortOrder Int     @default(0)

  tasks ActivationTask[]

  @@index([eventId])
}

model ActivationTask {
  id      String          @id @default(cuid())
  eventId String
  event   ActivationEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  // Set when the task was generated from a budget line (lead time,
  // ordering, confirmation), so ticking the task can tick the line.
  lineId  String?
  line    BudgetLine?     @relation(fields: [lineId], references: [id], onDelete: SetNull)

  text      String
  owner     String?
  // "team" | "ambassador"
  ownerKind String  @default("team")
  dueDate   DateTime?
  // "todo" | "doing" | "done" | "blocked"
  status    String  @default("todo")
  notes     String?
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
  @@index([status])
  @@index([dueDate])
}

// Who is working the event — SB team and brand ambassadors alike.
model EventStaff {
  id      String          @id @default(cuid())
  eventId String
  event   ActivationEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  name  String
  role  String?
  // "team" | "ambassador"
  kind  String @default("team")
  // Reference into the ambassador tracker once that's linked.
  externalRef String?
  email       String?
  phone       String?
  rateCents   Int?
  confirmed   Boolean @default(false)
  notes       String?

  @@index([eventId])
}
