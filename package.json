{
  "name": "sb-dashboard",
  "version": "1.0.0",
  "private": true,
  "allowScripts": {
    "@prisma/client": true,
    "prisma": true,
    "@prisma/engines": true
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma db push --skip-generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "test:li": "node scripts/test-li-capture.mjs && node scripts/test-li-report.mjs && node scripts/test-li-log.mjs && node scripts/test-li-script.js && node scripts/test-li-log-script.js",
    "test:li:e2e": "node scripts/test-li-e2e.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@prisma/client": "^5.22.0",
    "next": "14.2.18",
    "next-auth": "^4.24.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "nodemailer": "^7.0.7",
    "imapflow": "^1.0.164"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "prisma": "^5.22.0",
    "typescript": "^5.6.3"
  }
}